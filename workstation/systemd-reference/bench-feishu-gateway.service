[Unit]
Description=Bench Feishu deterministic gateway
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/mnt/data/bench-eval/service/gateway
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUTF8=1
Environment=TMPDIR=/mnt/data/bench-eval/temp
ExecStart=/home/lixiang/miniconda3/envs/tvg/bin/python -B -m bench_gateway.deployment run --root /mnt/data/bench-eval/service/gateway
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=infinity
StandardOutput=null
StandardError=null

[Install]
WantedBy=default.target
