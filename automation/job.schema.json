{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bench-eval-job.schema.json",
  "title": "bench-eval shared workstation job",
  "type": "object",
  "required": ["schema_version", "runner_protocol", "run_id", "mode"],
  "properties": {
    "schema_version": {"const": 1},
    "runner_protocol": {"enum": ["1.0", "1.1"]},
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "mode": {"type": "string", "minLength": 1},
    "workflow": {
      "type": "object",
      "required": ["targets"],
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["workstation_predictions", "lpai_predictions", "evaluation_report"]}
        },
        "so_policy": {"enum": ["installed", "prebuilt", "build", "auto"]},
        "reuse_policy": {"const": "verified_only"},
        "bench_strategy": {"enum": ["use_current_app", "isolated_candidate", "formal_update"]},
        "sources": {
          "type": "object",
          "properties": {
            "workstation_predictions": {"type": "string", "minLength": 1},
            "lpai_predictions": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "batch": {
      "type": "object",
      "required": ["batch_id", "scene_index", "scene_number", "scene_count", "scene"],
      "properties": {
        "batch_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,122}$"},
        "scene_index": {"type": "integer", "minimum": 0},
        "scene_number": {"type": "integer", "minimum": 1},
        "scene_count": {"type": "integer", "minimum": 1},
        "scene": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "command_set_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "evaluation_library": {
          "type": "object",
          "required": ["path", "sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "predictions": {
      "type": "object",
      "required": ["transfer_set_id", "destination_path"],
      "properties": {
        "transfer_set_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "source_path": {"type": "string", "minLength": 1},
        "destination_path": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "evaluation": {
      "type": "object",
      "required": ["evaluation_set_id", "prediction_path", "config_path"],
      "properties": {
        "evaluation_set_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "prediction_path": {"type": "string", "minLength": 1},
        "config_path": {"type": "string", "minLength": 1},
        "acceptance_policy": {"type": "object"},
        "validity_policy": {
          "type": "object",
          "properties": {
            "minimum_candidate_frames": {"type": "integer", "minimum": 0},
            "minimum_completed_frames": {"type": "integer", "minimum": 0},
            "required_tasks": {
              "type": "array",
              "items": {"enum": ["trajectory", "vision"]},
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "coordination": {
      "type": "object",
      "properties": {
        "allowed_actors": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 128},
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"runner_protocol": {"const": "1.0"}},
        "required": ["runner_protocol"]
      },
      "then": {
        "properties": {
          "predictions": {
            "required": ["transfer_set_id", "source_path", "destination_path"]
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
